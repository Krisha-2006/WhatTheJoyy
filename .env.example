# Copy to .env and edit. NEVER commit .env.

# ---- REQUIRED --------------------------------------------------------------
# At least 32 random characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-value

# ---- Book (fixed; owner only) ----------------------------------------------
BOOK_ID=selected_book
BOOK_PDF_PATH=data/books/selected_book.pdf
CHAPTERS_PATH=data/config/chapters.json
# Optional display title (otherwise the PDF metadata title is used)
BOOK_TITLE=
# 0 = top-level bookmarks are chapters, deeper bookmarks are sections
CHAPTER_OUTLINE_DEPTH=0

# ---- Storage ---------------------------------------------------------------
CHROMA_DIR=chroma_db
RUNTIME_DIR=runtime

# ---- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Set true after the first download to forbid any network access
EMBEDDING_LOCAL_ONLY=false

# ---- Chunking (starting values; changing them requires re-running ingestion) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# page-tail fragments shorter than this are merged into the previous chunk
MIN_CHUNK_CHARS=300

# ---- Retrieval policy (inspect with: python -m src.diagnose "your question") --
CANDIDATE_K=20
FINAL_K=4
# Dense gates use cosine SIMILARITY (1 - distance); starting values for MiniLM
MIN_SIMILARITY=0.20
MIN_TOP_SIMILARITY=0.28
# Hybrid = dense search + keyword (BM25) search fused. Keyword coverage is the
# IDF-weighted share of the question's terms found in a passage (0..1).
HYBRID_ENABLED=true
LEXICAL_MIN_COVERAGE=0.50
LEXICAL_TOP_COVERAGE=0.60
# 0 = off, 1 = also include the chunk before/after each hit (same chapter)
NEIGHBOR_EXPANSION=0
# smaller context = faster answers (4000 chars is roughly 1000 tokens)
MAX_CONTEXT_CHARS=4000

# ---- Ollama ------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=400
OLLAMA_TIMEOUT_SECONDS=120
# keep the model loaded between questions (avoids a slow reload)
OLLAMA_KEEP_ALIVE=30m
# Load embedding + Ollama models at API start so the first question is not slow
WARMUP_ON_START=true
# off       = deterministic checks only (fastest)
# single    = ONE extra LLM review call (default; good speed/safety balance)
# per_claim = one call per claim + a judge call (slowest, strictest)
LLM_VERIFIER_MODE=single
GROUNDING_MIN_LEXICAL_OVERLAP=0.4

# ---- Accounts / abuse control -------------------------------------------------
ALLOW_SIGNUP=true
# If set, signup requires this code (invite-only demo)
INVITE_CODE=
SESSION_TTL_HOURS=12
MIN_PASSWORD_LENGTH=10
MAX_QUESTION_CHARS=500
RATE_LIMIT_PER_MINUTE=6
LOGIN_ATTEMPTS_PER_MINUTE=8

# ---- UI ------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
